# Taurus Portal 生产环境配置模板
# 部署时通过环境变量覆盖，禁止写入真实敏感信息
VITE_SITE_NAME=Taurus
VITE_SITE_TITLE=Taurus — 企业级分布式运维平台

# ===== GitHub Pages 部署 =====
# 项目站点路径为 /taurus-portal/，资源必须带此前缀
VITE_BASE=/taurus-portal/
# 站点绝对源（origin），用于 SEO canonical / sitemap / JSON-LD 绝对化
VITE_SITE_URL=https://taurus-stack.github.io/taurus-portal

# VITE_API_BASE_URL=https://your-backend.example.com
# Contact 表单通过 FormSubmit 投递到邮箱，无需后端
# VITE_CONTACT_EMAIL=your-email@example.com