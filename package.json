{
  "name": "taurus-portal",
  "version": "0.4.0",
  "private": true,
  "description": "Taurus Stack - Enterprise Distributed Operations Platform Portal",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,vue,scss,css,html,md,json,jsonc}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,vue,scss,css,html,md,json,jsonc}\"",
    "prepare": "simple-git-hooks",
    "hooks:install": "simple-git-hooks",
    "check-dist": "node scripts/check-dist.mjs"
  },
  "dependencies": {
    "@vueuse/head": "^2.0.0",
    "axios": "^1.7.7",
    "pinia": "^2.2.4",
    "vue": "^3.5.12",
    "vue-i18n": "^9.14.1",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@types/node": "^22.8.6",
    "@vitejs/plugin-vue": "^5.1.4",
    "eslint": "9.15.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-vue": "9.32.0",
    "globals": "15.14.0",
    "lint-staged": "15.3.0",
    "prettier": "3.4.2",
    "sass": "^1.80.6",
    "simple-git-hooks": "2.11.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.18.0",
    "vite": "^5.4.10",
    "vue-eslint-parser": "9.4.3",
    "vue-tsc": "^2.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
